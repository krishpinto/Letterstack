# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit secrets.
# Where each production value comes from: docs/infrastructure.md

# ── Auth.js ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google sign-in. OAuth client from console.cloud.google.com → APIs & Services
# → Credentials, redirect URI <APP_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Amazon SES (sending) ──────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_FROM=newsletter@example.com        # must be on an SES-verified domain
TEST_TO=you@example.com                 # an inbox you control, for tests
# The SES configuration set that publishes delivery, bounce, complaint, open
# and click events to SNS. It must match the name in SES exactly: SES rejects
# every send that names a configuration set it doesn't have.
SES_CONFIGURATION_SET=
# ARN of the SNS topic that configuration set publishes to, e.g.
# arn:aws:sns:ap-south-1:123456789012:letterstack-ses-events (comma-separate
# several). /api/webhooks/ses rejects messages from any other topic and only
# confirms new subscriptions for topics listed here. When unset, signed
# messages from any SNS topic are accepted and a warning is logged.
SES_EVENTS_TOPIC_ARN=
# Signs one-click unsubscribe links. Falls back to AUTH_SECRET when unset.
# Changing it invalidates the unsubscribe links in every email already sent.
UNSUBSCRIBE_SECRET=

# Founder-only access. ADMIN_EMAILS gates /admin and every /api/admin/*
# route (comma-separated). ADMIN_NOTIFY_EMAIL, if set, gets one metadata
# email each time a campaign starts sending — leave it blank locally so
# development sends never mail anyone.
ADMIN_EMAILS=
ADMIN_NOTIFY_EMAIL=

# ── Neon database ─────────────────────────────────────────────────────────────
# Use your own Neon project (neon.tech has a free tier). Never point local
# development at the production database.
DATABASE_URL=

# Only read by drizzle.config.ts, and only for `npm run db:push`, which
# refuses to run unless ALLOW_DB_PUSH=1 and DATABASE_URL's host differs from
# PRODUCTION_DATABASE_HOST. Leave both unset. See docs/database.md.
# ALLOW_DB_PUSH=
# PRODUCTION_DATABASE_HOST=

# ── QStash (run locally: `npm run qstash:dev`) ────────────────────────────────
# Copy these from what that command prints when it starts. The URL is always the
# same; the token + signing keys come from the dev server output.
QSTASH_URL=http://127.0.0.1:8080
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Where QStash calls your app back. Local dev = your Next server.
APP_URL=http://localhost:3000

# ── UploadThing (image hosting for the editor) ────────────────────────────────
UPLOADTHING_TOKEN=

# ── Razorpay (payments) ─────────────────────────────────────────────────────────
# Test-mode keys from the Razorpay dashboard. KEY_SECRET is server-only —
# never prefix it with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Its own secret, set when you create the webhook in the Razorpay dashboard
# (Settings → Webhooks → <APP_URL>/api/payments/webhook). Not the key secret.
RAZORPAY_WEBHOOK_SECRET=

# ── Gmail sending (connect a personal Gmail account as a sender) ──────────────
# A separate OAuth client from AUTH's Google login — deliberately not reused,
# so this feature's consent screen/verification status never entangles with
# plain sign-in. Create one at console.cloud.google.com → APIs & Services →
# Credentials, add the gmail.send scope, and set the redirect URI to
# <APP_URL>/api/senders/gmail/callback.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# AES-256-GCM key for encrypting stored Gmail refresh tokens at rest.
# Generate with: openssl rand -base64 32
MAILBOX_ENCRYPTION_KEY=

# ── Contact form ──────────────────────────────────────────────────────────────
# Where the public contact form delivers. Unset, the form reports that it is
# not configured rather than mailing anyone.
CONTACT_INBOX=
# The address shown to visitors on the contact screen.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Invoices ──────────────────────────────────────────────────────────────────
# Where a customer's reply to a billing email lands. Comma-separated for more
# than one. Falls back to CONTACT_INBOX; unset, invoices carry no Reply-To
# rather than pointing at an address that can't receive.
SUPPORT_INBOX=
# Printed as the seller on invoices. Name defaults to "LetterStack" and the
# address is omitted entirely when unset — never faked. Website defaults to
# letterstack.site.
INVOICE_SUPPLIER_NAME=
INVOICE_SUPPLIER_ADDRESS=
INVOICE_SUPPLIER_EMAIL=
INVOICE_SUPPLIER_WEBSITE=
