# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit secrets.

# ── Amazon SES (sending) ──────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=          # IAM access key (your own, or ask Krish for one)
AWS_SECRET_ACCESS_KEY=
MAIL_FROM=newsletter@letterstack.site   # must be on the SES-verified domain
TEST_TO=you@example.com                 # an inbox you control, for tests

# ── Neon database ─────────────────────────────────────────────────────────────
# Share the same dev DB (ask Krish for the string) OR make your own free Neon
# project at neon.tech and paste its connection string here.
DATABASE_URL=

# ── QStash (run locally: `npx @upstash/qstash-cli dev`) ───────────────────────
# Copy these from what that command prints when it starts. The URL is always the
# same; the token + signing keys come from the dev server output.
QSTASH_URL=http://127.0.0.1:8080
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Where QStash calls your app back. Local dev = your Next server. On Vercel,
# leave unset to auto-detect, or set to your custom domain (https://letterstack.site).
APP_URL=http://localhost:3000

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# On a custom domain, set this to remove any callback-URL ambiguity.
# AUTH_URL=https://letterstack.site
