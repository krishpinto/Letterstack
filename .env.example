# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit secrets.

# ── Amazon SES (sending) ──────────────────────────────────────────────────────
# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=          # IAM access key (your own, or ask Krish for one)
AWS_SECRET_ACCESS_KEY=
MAIL_FROM=newsletter@krishpinto.co.in   # must be on the SES-verified domain
TEST_TO=you@example.com                 # an inbox you control, for tests

# Founder-only access. ADMIN_EMAILS gates /admin and every /api/admin/*
# route (comma-separated). ADMIN_NOTIFY_EMAIL, if set, gets one metadata
# email each time a campaign starts sending — leave it blank locally so
# development sends never mail anyone.
ADMIN_EMAILS=
ADMIN_NOTIFY_EMAIL=

# ── Neon database ─────────────────────────────────────────────────────────────
# Share the same dev DB (ask Krish for the string) OR make your own free Neon
# project at neon.tech and paste its connection string here.
DATABASE_URL=

# ── QStash (run locally: `npm run qstash:dev`) ────────────────────────────────
# Copy these from what that command prints when it starts. The URL is always the
# same; the token + signing keys come from the dev server output.
QSTASH_URL=http://127.0.0.1:8080
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Where QStash calls your app back. Local dev = your Next server.
APP_URL=http://localhost:3000

# ── Razorpay (payments) ─────────────────────────────────────────────────────────
# Test-mode keys from the Razorpay dashboard. KEY_SECRET is server-only —
# never prefix it with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Its own secret, set when you create the webhook in the Razorpay dashboard
# (Settings → Webhooks → <APP_URL>/api/payments/webhook). Not the key secret.
RAZORPAY_WEBHOOK_SECRET=

# ── Gmail sending (connect a personal Gmail account as a sender) ──────────────
# A separate OAuth client from AUTH's Google login — deliberately not reused,
# so this feature's consent screen/verification status never entangles with
# plain sign-in. Create one at console.cloud.google.com → APIs & Services →
# Credentials, add the gmail.send scope, and set the redirect URI to
# <APP_URL>/api/senders/gmail/callback.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# AES-256-GCM key for encrypting stored Gmail refresh tokens at rest.
# Generate with: openssl rand -base64 32
MAILBOX_ENCRYPTION_KEY=
